{
  "openapi": "3.1.0",
  "info": {
    "title": "DIYA API",
    "version": "0.1.0-phase4"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Root",
        "description": "Service pointer. Not part of the dispatch API itself -- just tells a\ncaller landing on the bare host where to find the interactive docs, the\nraw OpenAPI schema, and the health check.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness check. Always returns 200 with ok=true if the process is up\nand able to handle requests; no error cases.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "get": {
        "summary": "List Runs",
        "description": "List every precomputed dispatch run for Khavda (legacy, khavda-only).\n\nReturns one entry per (scenario_id, policy) pair found under\ndata/processed/runs/. No error cases -- an empty list if none exist.",
        "operationId": "list_runs_api_runs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunListEntry"
                  },
                  "type": "array",
                  "title": "Response List Runs Api Runs Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{scenario_id}/{policy}": {
      "get": {
        "summary": "Get Run",
        "description": "Fetch one precomputed dispatch run for Khavda (legacy, khavda-only).\n\nExample: GET /api/runs/S2/mpc\n\nErrors: 404 if no precomputed run exists for that scenario_id/policy pair.",
        "operationId": "get_run_api_runs__scenario_id___policy__get",
        "parameters": [
          {
            "name": "scenario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scenario Id"
            }
          },
          {
            "name": "policy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Policy"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sites/{site_id}/runs": {
      "get": {
        "summary": "List Site Runs",
        "description": "List every precomputed dispatch run for any registered site.\n\nSame shape as legacy GET /api/runs, generalized to site_id. A site with\nno precomputed runs yet (e.g. one just created via POST /api/sites)\nreturns an empty list, not an error.\n\nErrors: 404 if site_id is not registered.",
        "operationId": "list_site_runs_api_sites__site_id__runs_get",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RunListEntry"
                  },
                  "title": "Response List Site Runs Api Sites  Site Id  Runs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sites/{site_id}/runs/{scenario_id}/{policy}": {
      "get": {
        "summary": "Get Site Run",
        "description": "Fetch one precomputed dispatch run for any registered site.\n\nExample: GET /api/sites/khavda/runs/S2/mpc\n\nErrors: 404 if site_id is not registered, or if no precomputed run\nexists for that scenario_id/policy pair on this site.",
        "operationId": "get_site_run_api_sites__site_id__runs__scenario_id___policy__get",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site Id"
            }
          },
          {
            "name": "scenario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scenario Id"
            }
          },
          {
            "name": "policy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Policy"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sites/{site_id}/scenarios": {
      "get": {
        "summary": "List Site Scenarios",
        "description": "List the scenarios available for a site.\n\nFor khavda, returns the human-named S1/S2/S3 scenarios defined in\nconfig/scenarios.yaml. For any other site, returns one entry per\nscenario parquet file found under that site's own scenarios directory\n(id and name are the same string, since new sites have no separate\nhuman-naming step yet) -- an empty list if none have been uploaded.\n\nErrors: 404 if site_id is not registered.",
        "operationId": "list_site_scenarios_api_sites__site_id__scenarios_get",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScenarioSummary"
                  },
                  "title": "Response List Site Scenarios Api Sites  Site Id  Scenarios Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sites": {
      "get": {
        "summary": "List Sites",
        "description": "List every registered site (always includes the khavda seed site).\n\nNo error cases.",
        "operationId": "list_sites_api_sites_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SiteSummary"
                  },
                  "type": "array",
                  "title": "Response List Sites Api Sites Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Site",
        "description": "Register a new site, deriving a full SiteConfig from minimal input.\n\nExample request body:\n    {\"display_name\": \"Example Site\", \"lat\": -33.9, \"lon\": 18.4,\n     \"pv_capacity_kwp\": 10.0, \"battery_capacity_kwh\": 30.0}\n\nPV tilt/azimuth are derived from lat (tilt = abs(lat), array facing the\nequator); wind is omitted (rated_kw=0); battery is sized at a 3-hour\nC-rate; diesel reuses Khavda's combustion-property constants at the\ngiven (or default) rated_kw; VOLL values are ratios of\noutage_cost_inr_per_kwh. See core/site_store.py for the exact defaults.\n\nNo error cases beyond standard 422 body validation.",
        "operationId": "create_site_api_sites_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewSiteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sites/{site_id}": {
      "get": {
        "summary": "Get Site",
        "description": "Fetch one registered site's summary.\n\nErrors: 404 if site_id is not registered.",
        "operationId": "get_site_api_sites__site_id__get",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Patch Site",
        "description": "Partially update a site's SiteConfig. Only fields present in the\nrequest body are changed; omitted fields are left as-is.\n\nExample request body: {\"economics\": {\"diesel_price_inr_per_l\": 100.0,\n\"diesel_price_source\": \"manual override\", \"co2_price_inr_per_kg\": 2.0,\n\"voll_critical_inr_per_kwh\": 500.0, \"voll_essential_inr_per_kwh\": 60.0,\n\"voll_deferrable_inr_per_kwh\": 12.0}}\n\nErrors: 404 if site_id is not registered. 400 if site_id is a seed site\n(khavda) and the request touches any field other than economics,\nhorizon_hours, reserve_hours, or k_uncertainty -- Khavda's real hardware\nconfiguration must not be silently rewritten by an API call.",
        "operationId": "patch_site_api_sites__site_id__patch",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SiteUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Site",
        "description": "Permanently delete a site: removes its registry entry and its own\nconfig/scenarios/runs directory (sites/{site_id}/).\n\nErrors: 404 if site_id is not registered. 400/403 if site_id is a seed\nsite (khavda) -- seed sites can never be deleted through this API.",
        "operationId": "delete_site_api_sites__site_id__delete",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/solve_live": {
      "post": {
        "summary": "Solve Live",
        "description": "One-shot 72-hour forecast-driven dispatch plan for Khavda, using\nreal live weather for (lat, lon) where possible (legacy, khavda-only).\n\nExample request body: {\"lat\": 23.8443, \"lon\": 69.7317, \"soc_pct\": 60.0}\n\nWeather falls back live-fetch -> last cached forecast -> scenario replay\nif the network is unavailable; provenance.forecast_method in the\nresponse says which was actually used. No error cases -- this endpoint\nnever raises on a weather-fetch failure, only on malformed input (422).",
        "operationId": "solve_live_api_solve_live_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LiveSolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sites/{site_id}/solve_live": {
      "post": {
        "summary": "Solve Live For Site",
        "description": "Same as legacy POST /api/solve_live, generalized to any registered\nsite's own hardware/economics configuration.\n\nErrors: 404 if site_id is not registered; otherwise same as legacy\n/api/solve_live (never raises on a weather-fetch failure).",
        "operationId": "solve_live_for_site_api_sites__site_id__solve_live_post",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LiveSolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/resolve": {
      "post": {
        "summary": "Resolve",
        "description": "Re-solve a full Khavda scenario (S1/S2/S3) via rolling MPC with\nuser-adjusted cost/CO2/reliability weights, k_uncertainty, and diesel\nprice (legacy, khavda-only).\n\nExample request body: {\"scenario_id\": \"S1\", \"weights\": {\"cost\": 1.0,\n\"co2\": 1.0, \"reliability\": 1.0}, \"k_uncertainty\": 1.0,\n\"diesel_price_inr_per_l\": 92.5}\n\nSLOW: ~60-65s (168 sequential 24h MILP solves) -- see the comment block\nabove this route for why, and FREEZE_NOTES.md for the accepted timing.\n\nErrors: 404 if scenario_id is not one of the configured scenarios, or if\nthat scenario has no parquet data on disk.",
        "operationId": "resolve_api_resolve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sites/{site_id}/resolve": {
      "post": {
        "summary": "Resolve For Site",
        "description": "Same as legacy POST /api/resolve, generalized to any registered\nsite's own scenario data (looked up as\n<that site's scenarios_dir>/{scenario_id}.parquet).\n\nErrors: 404 if site_id is not registered, or if that site has no\nparquet data for the given scenario_id (e.g. a newly created site with\nno scenarios uploaded yet).",
        "operationId": "resolve_for_site_api_sites__site_id__resolve_post",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
