# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg

# Node / web workstream
node_modules/
dist/
build/
.next/
.turbo/

# Data caches — but data/processed and web/public/runs ARE committed
data/raw/*
!data/raw/.gitkeep

# Runtime-created sites (via POST /api/sites) -- sites/registry.json itself
# IS committed (seeded with the khavda record); only per-site directories
# created at runtime are ignored, since they're ephemeral local state, not
# part of the repo (see DEPLOYMENT.md's note on Render's free tier having
# no persistent disk).
sites/site_*/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
